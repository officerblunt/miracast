<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Miracast.Avalonia.ViewModels"
        xmlns:receiver="using:Miracast.Receiver"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Miracast.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        MinWidth="640"
        MinHeight="360"
        Background="Black"
        Title="Miracast Receiver">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid Background="Black">
        <Image x:Name="FrameImage" Stretch="Uniform" />

        <Border IsVisible="{Binding HasAvailableSources}"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="16"
                Padding="14"
                CornerRadius="8"
                Background="#D0202020"
                MaxWidth="360">
            <StackPanel Spacing="10">
                <TextBlock Text="Confirm connection on this receiver"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="SemiBold" />
                <TextBlock Text="Select the computer that is currently waiting to connect:"
                           Foreground="#D0FFFFFF"
                           TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding AvailableSources}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="receiver:MiracastSourceInfo">
                            <Button Click="OnApproveConnectionClicked"
                                    HorizontalContentAlignment="Stretch"
                                    Margin="0,3">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding HardwareAddress}"
                                                   FontSize="11"
                                                   Opacity="0.7" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               Text="{Binding Strength, StringFormat={}{0}%}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border VerticalAlignment="Bottom"
                Background="#B0000000"
                Padding="16,10">
            <TextBlock Text="{Binding Status}"
                       Foreground="White"
                       FontSize="14"
                       TextWrapping="Wrap" />
        </Border>
    </Grid>

</Window>
