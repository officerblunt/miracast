#!/bin/sh
set -eu

if [ "$#" -ne 2 ]; then
    exit 64
fi

group_interface=$1
parent_interface=$2

case "$group_interface" in
    p2p-dev-*|*[!A-Za-z0-9_.-]*|p2p-|[!p]*|p|p2|p2p)
        exit 64
        ;;
    p2p-*)
        ;;
    *)
        exit 64
        ;;
esac

case "$parent_interface" in
    ''|*[!A-Za-z0-9_.-]*)
        exit 64
        ;;
esac

group_phy=$(readlink -f "/sys/class/net/$group_interface/phy80211" 2>/dev/null || true)
parent_phy=$(readlink -f "/sys/class/net/$parent_interface/phy80211" 2>/dev/null || true)

if [ -z "$group_phy" ]; then
    exit 0
fi
if [ -z "$parent_phy" ] || [ "$group_phy" != "$parent_phy" ]; then
    exit 65
fi

exec /usr/sbin/iw dev "$group_interface" del
